{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",             // Changed from node16 to commonjs
    "moduleResolution": "node",       // Changed from node16 to node
    "esModuleInterop": true,
    "skipLibCheck": true,             // This ignores errors in node_modules
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": "./app/src",
    "outDir": "./dist",
    "types": ["node", "jest"]         // Keep this clean
  },
  "include": ["app/src/**/*"]
}