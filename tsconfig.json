{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": "./app/src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "zod": ["node_modules/zod"]
    },
    "types": ["node"]
  },
  "include": ["app/src/**/*"]
}