<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Your OTP Code</title>
    
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f9f9f9;
        padding: 20px;
      }
      .container {
        background: white;
        padding: 20px;
        border-radius: 10px;
        max-width: 400px;
        margin: auto;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      }
      h2 {
        color: #333;
      }
      .otp {
        font-size: 22px;
        font-weight: bold;
        color: #007bff;
        margin-top: 10px;
      }
      p {
        color: #555;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>🔐 Your One-Time Password</h2>
      <p>Hi <%= name %>,</p>
      <p>Your OTP code is:</p>
      <div class="otp"><%= otp %></div>
      <p>This code will expire in 5 minutes.</p>
      <p>Thank you for using our service!</p>
    </div>
  </body>
</html>
